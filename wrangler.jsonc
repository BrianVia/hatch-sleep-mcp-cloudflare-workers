{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hatch-mcp", "main": "src/index.ts", "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "HATCH_SESSION", "class_name": "HatchSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HatchSession"] }],
  "routes": [{ "pattern": "hatch.example.com", "custom_domain": true }]
}
